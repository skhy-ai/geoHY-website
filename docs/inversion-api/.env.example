# GeoHY Inversion API — Local Environment Variables
# Copy this file to .env and fill in your values.
# This file is NOT committed to git.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Add your Netlify preview URLs here during development too.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Future: Supabase (for writing results to the database) ───────────────────
# SUPABASE_URL=https://zgqbpxeukhmjfcscbxjc.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
